# ─────────────────────────────────────────────────────────────────────
# Resend — newsletter capture + contact form
#
# Copy this file to `.env.local` for local dev, and set the same values
# as environment variables in the hosting provider for production.
# While RESEND_API_KEY is empty both routes run in test mode: they log
# to the server console and return success, so the UI flow works end to
# end without an account.
#
# Setup order:
#   1. Verify the sending domain in Resend — use the SUBDOMAIN
#      `send.maitstudio.com`, not the apex. Resend asks for an MX record
#      and the apex MX must stay pointed at the inbox provider
#      (Cloudflare Email Routing / Google Workspace), or incoming mail
#      to hello@maitstudio.com breaks.
#   2. Create the API key   → https://resend.com/api-keys
#   3. Create the audience  → https://resend.com/audiences (copy its ID)
# ─────────────────────────────────────────────────────────────────────

# Account key. One key covers both routes below.
RESEND_API_KEY=

# ── Newsletter (POST /api/subscribe) ─────────────────────────────────
# The audience subscribers are added to. This is the list the studio
# sends Broadcasts (newsletters) to from the Resend dashboard.
RESEND_AUDIENCE_ID=

# ── Contact form (POST /api/contact) ─────────────────────────────────
# CONTACT_FROM must be an address on the domain verified in step 1 —
# Resend rejects a From that it can't authenticate. Nobody replies to
# it; the route sets Reply-To to the enquirer's own address.
CONTACT_FROM="MAIT Studio <hello@send.maitstudio.com>"

# Where enquiries land. This one is the real inbox that gets read.
CONTACT_TO="hello@maitstudio.com"
